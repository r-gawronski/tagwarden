# Source of the sync-run-*.svg diagrams.
# Render:
#   d2 --theme 0 --pad 40 sync-run.d2 sync-run-light.svg
#   d2 --theme 200 --pad 40 sync-run.d2 sync-run-dark.svg
#   add --sketch for the sync-run-sketch-*.svg variants
shape: sequence_diagram
style.font-size: 18

team: Team {style: {border-radius: 14; shadow: true}}
c: Controller {style: {border-radius: 14; shadow: true}}
j: Sync Job {style: {border-radius: 14; shadow: true}}
p: Proxy {style: {border-radius: 14; shadow: true}}
u: Upstream {style: {border-radius: 14; shadow: true}}
r: Your registry {style: {border-radius: 14; shadow: true}}

on apply: {
  team -> c: ArtifactMirror
  c -> c: check against target
  c -> j: CronJob
}

on schedule: {
  j -> p: list tags
  p -> u: list tags
  j -> j: select tags
  j -> p: fetch new digests
  p -> u: fetch
  j -> r: push by digest, with signatures
  j -> c: result
  c -> team: mirror status
}
