# Source of the how-it-works-*.svg diagrams.
# Render:
#   d2 --theme 0 --pad 40 how-it-works.d2 how-it-works-light.svg
#   d2 --theme 200 --pad 40 how-it-works.d2 how-it-works-dark.svg
#   add --sketch for the how-it-works-sketch-*.svg variants
direction: right

classes: {
  node: {style: {border-radius: 14; shadow: true; font-size: 18}}
  store: {shape: cylinder; style: {shadow: true; font-size: 18}}
}

cluster: Kubernetes cluster {
  style.border-radius: 20
  mirror: ArtifactMirror {class: node}
  target: ClusterMirrorTarget {class: node}
  controller: Controller {class: node}
  job: Sync Job {class: node}

  mirror -> controller: team
  target -> controller: platform
  controller -> job: CronJob
}

proxy: HTTPS proxy {class: node}
upstream: Upstream {class: store}
registry: Your registry {class: store}

cluster.job -> proxy: list, fetch
proxy -> upstream
cluster.job -> registry: push by digest {style.stroke-width: 3}
