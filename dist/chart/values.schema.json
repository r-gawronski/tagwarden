{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Tagwarden chart values",
  "type": "object",
  "additionalProperties": false,
  "definitions": {
    "stringMap": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "kubernetesObject": {
      "description": "Passed through to a Kubernetes field; the API server validates it.",
      "type": "object"
    },
    "digest": {
      "type": "string",
      "pattern": "^(sha256:[a-f0-9]{64})?$"
    },
    "dnsSubdomain": {
      "type": "string",
      "maxLength": 253,
      "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]*[a-z0-9])?)*$"
    },
    "dnsLabel": {
      "type": "string",
      "maxLength": 63,
      "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
    },
    "toggle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled"],
      "properties": { "enabled": { "type": "boolean" } }
    }
  },
  "properties": {
    "nameOverride": { "type": "string" },
    "fullnameOverride": { "type": "string" },
    "manager": {
      "type": "object",
      "additionalProperties": false,
      "required": ["image", "args", "env", "healthProbe"],
      "properties": {
        "replicas": { "type": "integer", "minimum": 0 },
        "image": {
          "type": "object",
          "additionalProperties": false,
          "required": ["repository"],
          "properties": {
            "repository": { "type": "string", "minLength": 1 },
            "tag": { "type": "string" },
            "digest": { "$ref": "#/definitions/digest" },
            "pullPolicy": { "enum": ["Always", "IfNotPresent", "Never"] }
          }
        },
        "args": {
          "description": "Must keep the --sync-image and --denied-cidrs flags.",
          "type": "array",
          "items": { "type": "string" },
          "allOf": [
            { "contains": { "type": "string", "pattern": "^--sync-image=" } },
            { "contains": { "type": "string", "pattern": "^--denied-cidrs=" } }
          ]
        },
        "healthProbe": {
          "type": "object",
          "additionalProperties": false,
          "required": ["port"],
          "properties": { "port": { "type": "integer", "minimum": 1, "maximum": 65535 } }
        },
        "env": { "type": "array", "items": { "$ref": "#/definitions/kubernetesObject" } },
        "imagePullSecrets": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name"],
            "properties": { "name": { "type": "string", "minLength": 1 } }
          }
        },
        "podSecurityContext": { "$ref": "#/definitions/kubernetesObject" },
        "securityContext": { "$ref": "#/definitions/kubernetesObject" },
        "resources": { "$ref": "#/definitions/kubernetesObject" },
        "affinity": { "$ref": "#/definitions/kubernetesObject" },
        "nodeSelector": { "$ref": "#/definitions/stringMap" },
        "tolerations": { "type": "array", "items": { "$ref": "#/definitions/kubernetesObject" } },
        "topologySpreadConstraints": { "type": "array", "items": { "$ref": "#/definitions/kubernetesObject" } },
        "strategy": { "$ref": "#/definitions/kubernetesObject" },
        "priorityClassName": { "type": "string" },
        "terminationGracePeriodSeconds": { "type": "integer", "minimum": 0 },
        "labels": { "$ref": "#/definitions/stringMap" },
        "annotations": { "$ref": "#/definitions/stringMap" },
        "pod": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "labels": { "$ref": "#/definitions/stringMap" },
            "annotations": { "$ref": "#/definitions/stringMap" }
          }
        }
      }
    },
    "argocd": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tracking": { "enum": ["", "inherit"] },
        "instanceLabel": { "type": "string", "minLength": 1, "maxLength": 317 }
      }
    },
    "syncImage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repository": { "type": "string" },
        "tag": { "type": "string" },
        "digest": { "$ref": "#/definitions/digest" }
      }
    },
    "deniedCIDRs": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[0-9a-fA-F:.]+/[0-9]{1,3}$" }
    },
    "leaderElection": { "$ref": "#/definitions/toggle" },
    "rbac": {
      "type": "object",
      "additionalProperties": false,
      "properties": { "helpers": { "$ref": "#/definitions/toggle" } }
    },
    "serviceAccount": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled"],
      "properties": {
        "enabled": { "type": "boolean" },
        "name": { "type": "string" },
        "labels": { "$ref": "#/definitions/stringMap" },
        "annotations": { "$ref": "#/definitions/stringMap" }
      }
    },
    "crd": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "keep"],
      "properties": {
        "enabled": { "type": "boolean" },
        "keep": { "type": "boolean" }
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "port", "secure"],
      "properties": {
        "enabled": { "type": "boolean" },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "secure": { "type": "boolean" }
      }
    },
    "prometheus": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled"],
      "properties": {
        "enabled": { "type": "boolean" },
        "tlsConfig": { "$ref": "#/definitions/kubernetesObject" },
        "labels": { "$ref": "#/definitions/stringMap" },
        "annotations": { "$ref": "#/definitions/stringMap" }
      }
    },
    "networkPolicy": { "$ref": "#/definitions/toggle" },
    "targets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "spec"],
        "properties": {
          "name": { "$ref": "#/definitions/dnsSubdomain" },
          "spec": { "$ref": "#/definitions/kubernetesObject" }
        }
      }
    },
    "mirrors": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "namespace", "spec"],
        "properties": {
          "name": { "$ref": "#/definitions/dnsSubdomain" },
          "namespace": { "$ref": "#/definitions/dnsLabel" },
          "spec": { "$ref": "#/definitions/kubernetesObject" }
        }
      }
    }
  }
}
