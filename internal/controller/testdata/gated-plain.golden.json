                  "terminationMessagePolicy": "File",
                  "securityContext": {
                    "capabilities": {
                      "drop": [
                        "ALL"
                      ]
                    },
                    "readOnlyRootFilesystem": true,
                    "allowPrivilegeEscalation": false
                  }
                }
              ],
              "containers": [
                {
                  "name": "sync",
                  "image": "registry.example.internal/tagwarden:test",
                  "args": [
                    "sync",
                    "--spec",
                    "/etc/tagwarden/spec.json"
